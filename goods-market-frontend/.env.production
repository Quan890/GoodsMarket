# ============================================================
# 生产环境配置
# ============================================================
# 打包时使用 .env.production 中的变量
# Nginx 反向代理通常将 /api 转发到后端，保持与开发环境一致

# 后端 API 基础地址（生产环境由 Nginx 代理 /api → 后端服务）
VITE_API_BASE_URL=/api

# 应用标题
VITE_APP_TITLE=好物集市

# 是否开启调试模式（生产环境关闭）
VITE_APP_DEBUG=false
