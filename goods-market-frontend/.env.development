# ============================================================
# 开发环境配置
# ============================================================
# Vite 要求自定义变量必须以 VITE_ 前缀才能在 import.meta.env 中访问
# 在代码中通过 import.meta.env.VITE_API_BASE_URL 获取

# 后端 API 基础地址（开发环境走 vite proxy，使用相对路径 /api）
VITE_API_BASE_URL=/api

# 应用标题
VITE_APP_TITLE=好物集市

# 是否开启调试模式（控制 v-console 等调试工具）
VITE_APP_DEBUG=true
